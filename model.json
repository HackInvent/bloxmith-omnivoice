{
  "kind": "omnivoice",
  "version": "0.1.0",
  "title": "OmniVoice",
  "description": "Run the pinned local OmniVoice model in auto, voice-design or reference-cloning mode; publish complete WAV or Ogg/Opus files.",
  "repository_url": "https://github.com/HackInvent/bloxmith-omnivoice",
  "bloxsmith_compatibility": [
    "1.0.9"
  ],
  "tested_with_bloxsmith": "1.0.9",
  "prerequisites": [
    {
      "type": "executable",
      "name": "ffmpeg"
    },
    {
      "type": "manual",
      "name": "Linux; dedicated Python 3.12, pinned OmniVoice/Transformers/PyTorch and 3.27 GB of verified model/codec assets. Codec has separate Boson terms."
    }
  ],
  "locales": {
    "en": "locales/en.json",
    "fr": "locales/fr.json"
  },
  "ports": {
    "inputs": [
      {
        "id": 1,
        "name": "text",
        "title": "Text",
        "accepts": [
          "text/plain",
          "application/json",
          "message/*"
        ],
        "multiplicity": "one",
        "required": false,
        "execution_requirement": "not_required_for_execution"
      },
      {
        "id": 2,
        "name": "command",
        "title": "Interrupt",
        "accepts": [
          "application/json"
        ],
        "multiplicity": "one",
        "required": false,
        "execution_requirement": "not_required_for_execution"
      }
    ],
    "outputs": [
      {
        "id": 1,
        "name": "audio_file",
        "title": "Complete audio file",
        "emits": [
          "file/path",
          "text/plain",
          "message/*"
        ],
        "multiplicity": "many"
      },
      {
        "id": 2,
        "name": "metadata",
        "title": "Audio metadata",
        "emits": [
          "application/json",
          "message/*"
        ],
        "multiplicity": "many"
      },
      {
        "id": 3,
        "name": "status",
        "title": "Status",
        "emits": [
          "application/json",
          "message/*"
        ],
        "multiplicity": "many"
      }
    ]
  },
  "config": {
    "asset_directory": "",
    "environment_python": "",
    "voice_mode": "auto",
    "language": "auto",
    "voice_instruction": "",
    "reference_audio": "",
    "reference_text": "",
    "device": "cuda:0",
    "precision": "float16",
    "format": "ogg_opus",
    "output_directory": "",
    "target_duration_sec": 0,
    "speed": 1,
    "num_step": 32,
    "guidance_scale": 2,
    "t_shift": 0.1,
    "position_temperature": 5,
    "class_temperature": 0,
    "layer_penalty_factor": 5,
    "denoise": true,
    "preprocess_prompt": true,
    "postprocess_output": true,
    "pad_duration": 0.1,
    "fade_duration": 0.1,
    "audio_chunk_duration": 15,
    "audio_chunk_threshold": 30,
    "threads": 2,
    "max_audio_sec": 60,
    "max_segments": 16,
    "max_context_tokens": 4096,
    "max_text_chars": 1000,
    "timeout_sec": 240,
    "memory_limit_mib": 0,
    "min_available_ram_mib": 8192,
    "max_pending": 4
  },
  "port_capabilities": {
    "can_add_inputs": false,
    "can_add_outputs": false
  },
  "runtime": {
    "initial_state": "waiting",
    "runtime_executable": true,
    "active_worker": true,
    "centralized_executor": "generic",
    "centralized_dependency_mode": "any_event",
    "file_browser": true,
    "active_execution_policy": "on_each_event"
  },
  "ui_assets": {
    "modal": [
      {
        "kind": "css",
        "path": "assets/css/properties.css"
      },
      {
        "kind": "js",
        "path": "assets/js/properties.js"
      },
      {
        "kind": "js",
        "path": "assets/js/settings.js"
      },
      {
        "kind": "js",
        "path": "assets/js/block_modal.js"
      }
    ],
    "inspector_panel": [
      {
        "kind": "css",
        "path": "assets/css/properties.css"
      },
      {
        "kind": "js",
        "path": "assets/js/properties.js"
      },
      {
        "kind": "js",
        "path": "assets/js/settings.js"
      },
      {
        "kind": "js",
        "path": "assets/js/inspector_panel.js"
      }
    ],
    "node_card": [
      {
        "kind": "css",
        "path": "assets/css/node_card.css"
      }
    ]
  }
}
